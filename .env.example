# Copia este archivo como ".env" y sustituye el valor por una clave propia.
# El archivo .env NO se sube al repositorio (está en .gitignore).
# Genera una clave con:
#   docker run --rm alpine sh -c "head -c 32 /dev/urandom | base64"
IPSEC_PSK=CAMBIA_ESTE_VALOR_POR_UNA_CLAVE_GENERADA

# Bloque 4: anti-spoofing por interfaz. 0 = desactivado (para demostrar el fallo), 1 = activado.
ANTISPOOF=0
