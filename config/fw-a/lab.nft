# Bloque 3 - Política de firewall de la Sede A (fw-a) con túnel IPsec
# Las reglas usan direcciones IP y no nombres de interfaz (ethX), porque Docker
# reasigna esos nombres cada vez que se recrean las redes.
# Política por defecto: denegar (equivale a la "cleanup rule" de Check Point).
# Limitación conocida (se aborda en el bloque 4): al filtrar solo por IP, un
# paquete que llega por la WAN con origen falsificado de una red interna
# (por ejemplo, la LAN local) coincide con las reglas de esa LAN.

define LAN   = 10.10.1.0/24
define DMZ   = 10.10.2.0/24
define WEB   = 10.10.2.10
define LAN_R = 10.20.1.0/24
define WEB_R = 10.20.2.10
define PEER  = 203.0.113.20

# Borra solo nuestra tabla (no toca las reglas internas de Docker para DNS)
table inet lab_filter
delete table inet lab_filter

table inet lab_filter {
    chain input {
        type filter hook input priority 0; policy drop;
        ct state established,related counter accept
        ct state invalid counter drop
        iifname "lo" accept
        # Diagnóstico: la LAN puede hacer ping al firewall
        ip saddr $LAN icmp type echo-request counter accept
        # IPsec: IKE (UDP 500), NAT-T (UDP 4500) y ESP, solo desde el firewall de la otra sede
        ip saddr $PEER udp dport { 500, 4500 } counter accept
        ip saddr $PEER ip protocol esp counter accept
        counter comment "descartado: input"
    }
    chain forward {
        type filter hook forward priority 0; policy drop;
        ct state established,related counter accept
        ct state invalid counter drop
        # LAN -> servidor web de la DMZ local: solo HTTP y HTTPS
        ip saddr $LAN ip daddr $WEB tcp dport { 80, 443 } counter accept
        # LAN -> DMZ local: ping para diagnóstico
        ip saddr $LAN ip daddr $DMZ icmp type echo-request counter accept
        # Entre sedes, hacia la otra sede (sale cifrado por el túnel)
        ip saddr $LAN ip daddr $LAN_R icmp type echo-request counter accept
        ip saddr $LAN ip daddr $WEB_R tcp dport { 80, 443 } counter accept
        # Entre sedes, desde la otra sede (llega descifrado del túnel)
        ip saddr $LAN_R ip daddr $LAN icmp type echo-request counter accept
        ip saddr $LAN_R ip daddr $WEB tcp dport { 80, 443 } counter accept
        # Todo lo demás (DMZ -> cualquiera, WAN -> cualquiera, ...) se descarta
        counter comment "descartado: forward"
    }
    chain output {
        type filter hook output priority 0; policy accept;
    }
}
